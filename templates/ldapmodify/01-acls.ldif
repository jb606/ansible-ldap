dn: olcDatabase={1}mdb,cn=config
changetype: modify
replace: olcAccess
olcAccess: {0}to *
  by dn.exact="{{ admin_dn }}" manage
  by dn.exact="gidNumber=0+uidNumber=0,cn=peercred,cn=external,cn=auth" manage
  by dn.subtree="ou=admins,{{ base_dn }}" manage
  by * break
olcAccess: {1}to attrs=userPassword
  by self write
  by dn.subtree="ou=computers,{{ base_dn }}" auth
  by dn.exact="{{ radius_bind_dn }}" auth
  by anonymous auth
  by * none
olcAccess: {2}to attrs=shadowLastChange,shadowExpire,shadowFlag,shadowInactive,shadowMax,shadowMin,shadowWarning
  by self read
  by dn.exact="{{ nss_bind_dn }}" read
  by * none
olcAccess: {3}to attrs=pwdAccountLockedTime,pwdChangedTime,pwdFailureTime,pwdGraceUseTime,pwdHistory,pwdPolicySubentry,pwdReset,pwdStartTime
  by self read
  by * none
olcAccess: {4}to attrs=uidNumber,gidNumber,loginShell,homeDirectory
  by self read
  by dn.exact="gidNumber=0+uidNumber=0,cn=peercred,cn=external,cn=auth" manage
  by dn.exact="{{ admin_dn }}" write
  by dn.subtree="ou=computers,{{ base_dn }}" read
  by users read
  by * none
olcAccess: {5}to attrs=entryCSN,entryUUID,modifyTimestamp,modifiersName,createTimestamp,creatorsName,structuralObjectClass
  by * none
olcAccess: {6}to dn.subtree="ou=Password,ou=Policies,{{ base_dn }}"
  by users read
  by * none
olcAccess: {7}to attrs=cn,sn,givenName,displayName,mail,member,memberOf,uniqueMember
  by self read
  by dn.subtree="ou=computers,{{ base_dn }}" read
  by users read
  by * none
olcAccess: {8}to attrs=telephoneNumber,mobile,description
  by self write
  by dn.subtree="ou=computers,{{ base_dn }}" read
  by users read
  by * none
olcAccess: {9}to dn.subtree="{{ base_dn }}"
  by self read
  by dn.subtree="ou=computers,{{ base_dn }}" read
  by dn.exact="{{ sudo_bind_dn }}" read
  by users read
  by * none
